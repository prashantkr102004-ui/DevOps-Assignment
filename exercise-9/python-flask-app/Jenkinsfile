pipeline {
    agent any

    environment {
        APP_DIR = 'exercise-9/python-flask-app'
        VENV = "${WORKSPACE}/.venv"
        DEPLOY_DIR = "${WORKSPACE}/python-app-deploy"
    }

    stages {
        stage('Build') {
            steps {
                dir("${APP_DIR}") {
                    echo 'Creating virtual environment and installing dependencies...'
                    sh '''
                        python3 -m venv "$VENV"
                        "$VENV/bin/python" -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir("${APP_DIR}") {
                    echo 'Running unit tests...'
                    sh '''
                        "$VENV/bin/python" -m unittest discover -s . -v
                    '''
                }
            }
        }

        stage('Code Quality') {
            steps {
                dir("${APP_DIR}") {
                    echo 'Running Flake8 code quality checks...'
                    sh '''
                        "$VENV/bin/python" -m flake8 app.py test_app.py
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                dir("${APP_DIR}") {
                    echo 'Deploying application...'
                    sh '''
                        mkdir -p "$DEPLOY_DIR"
                        cp app.py "$DEPLOY_DIR/app.py"
                        test -f "$DEPLOY_DIR/app.py"
                        echo "Application copied to $DEPLOY_DIR"
                    '''
                }
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting the deployed Flask application...'
                sh '''
                    if [ -f "$DEPLOY_DIR/app.pid" ]; then
                        old_pid=$(cat "$DEPLOY_DIR/app.pid")
                        if kill -0 "$old_pid" 2>/dev/null; then
                            kill "$old_pid" || true
                        fi
                        rm -f "$DEPLOY_DIR/app.pid"
                    fi

                    nohup "$VENV/bin/python" "$DEPLOY_DIR/app.py" \
                        > "$DEPLOY_DIR/app.log" 2>&1 &

                    echo $! > "$DEPLOY_DIR/app.pid"
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing deployed application over HTTP...'
                sh '''
                    ready=0

                    for attempt in $(seq 1 20); do
                        if "$VENV/bin/python" -c \
                            "from urllib.request import urlopen; r=urlopen('http://127.0.0.1:5000/', timeout=2); assert r.status == 200 and r.read().decode() == 'Hello, Jenkins Multi-Stage Pipeline!'"; then
                            ready=1
                            break
                        fi
                        sleep 1
                    done

                    if [ "$ready" -ne 1 ]; then
                        echo "Application health check failed."
                        cat "$DEPLOY_DIR/app.log"
                        exit 1
                    fi

                    echo "HTTP health check passed."
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}